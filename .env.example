# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres connection string, pooled endpoint.
DATABASE_URL=

# Public origin of the site, no trailing slash.
NEXT_PUBLIC_SITE_URL=

# Signing key for Better Auth sessions. At least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# The origin Better Auth is served from. Leave unset in production, where it
# defaults to NEXT_PUBLIC_SITE_URL. Set it for a local server, so cookies are
# not issued with the __Secure- prefix over plain http.
# BETTER_AUTH_URL=http://localhost:3000

# The shared secret the daily snapshot job presents, at least 32 characters.
# Vercel Cron sends it as a bearer token. Without it the job endpoint refuses
# every request and campaign_daily_stats stops accumulating, so the charts
# freeze on the last day it ran.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# Cloudflare Turnstile, the bot check in front of the pledge form.
#
# Set both or neither. Set, every pledge must carry a token Cloudflare accepts.
# Unset, verification is skipped so the form works on a machine with no
# Cloudflare account, and a pledge under the auto approve limit is still
# approved, so the local form behaves the way the deployed one does.
#
# Required in production. There the app refuses to record a pledge without
# them, so a missing variable is a failed deploy and not a form that quietly
# stops checking. The site key is not secret and is rendered into the widget.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The ceiling for approving a pledge without a person looking at it, in whole
# shillings. A pledge whose total lands under this is verified on submission
# and counts toward the public figure straight away. Anything at or above it
# waits for the treasurer. Defaults to 5000000 when unset.
# PLEDGE_AUTO_APPROVE_LIMIT_KES=5000000
