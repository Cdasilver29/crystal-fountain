# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres connection string, pooled endpoint.
DATABASE_URL=

# Public origin of the site, no trailing slash.
NEXT_PUBLIC_SITE_URL=

# Unlocks /admin/pledges until real admin auth lands. At least 24 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SECRET=
