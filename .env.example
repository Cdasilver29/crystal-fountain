# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres connection string, pooled endpoint.
DATABASE_URL=

# Public origin of the site, no trailing slash.
NEXT_PUBLIC_SITE_URL=

# Signing key for Better Auth sessions. At least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# The origin Better Auth is served from. Leave unset in production, where it
# defaults to NEXT_PUBLIC_SITE_URL. Set it for a local server, so cookies are
# not issued with the __Secure- prefix over plain http.
# BETTER_AUTH_URL=http://localhost:3000

# The shared secret the daily snapshot job presents, at least 32 characters.
# Vercel Cron sends it as a bearer token. Without it the job endpoint refuses
# every request and campaign_daily_stats stops accumulating, so the charts
# freeze on the last day it ran.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# Cloudflare Turnstile, the bot check in front of the pledge form.
#
# Set both or neither. Set, every pledge must carry a token Cloudflare accepts.
# Unset, verification is skipped so the form works on a machine with no
# Cloudflare account, and a pledge under the auto approve limit is still
# approved, so the local form behaves the way the deployed one does.
#
# Required in production. There the app refuses to record a pledge without
# them, so a missing variable is a failed deploy and not a form that quietly
# stops checking. The site key is not secret and is rendered into the widget.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google sign in for the admin portal, alongside email and password.
#
# Set both or neither. Set, the sign in page offers a Google button. Unset, the
# button does not render and email and password works exactly as before, so a
# machine with no Google project is a working configuration. A half configured
# pair is an error rather than a guess.
#
# Not required in production, unlike the Turnstile pair. Missing keys there
# close a door rather than open one: the portal simply has one way in.
#
# These authorise nobody by themselves. A Google account can only sign in if
# its address already belongs to an active row in admin_users, which is what a
# super administrator creating somebody at /admin/users does. There is no
# separate allowlist. Anything else is refused and written to audit_log as
# admin.google_rejected.
#
# In the Google Cloud console, create an OAuth 2.0 Client ID of type "Web
# application" and add this exact authorised redirect URI, matching the origin
# the app is actually served from:
#   http://localhost:3000/api/auth/callback/google
#   https://<your site>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The ceiling for approving a pledge without a person looking at it, in whole
# shillings. A pledge whose total lands under this is verified on submission
# and counts toward the public figure straight away. Anything at or above it
# waits for the treasurer. Defaults to 5000000 when unset.
# PLEDGE_AUTO_APPROVE_LIMIT_KES=5000000

# Sentry, for crash reports. Optional everywhere.
#
# Unset, the SDK stays inert and nothing is sent, which is what a laptop wants.
# Unset in production it means crashes go unreported, which is a gap rather
# than a danger, so the app still runs without it.
#
# Two variables, because a browser cannot read the first one. Next only inlines
# NEXT_PUBLIC_ values into the client bundle, so SENTRY_DSN covers the server,
# which means route handlers, server components and the cron job, and
# NEXT_PUBLIC_SENTRY_DSN covers errors thrown in somebody's browser. Set both to
# the same DSN to report from both halves, or set only the first to report from
# the server alone. A DSN is not a secret, so publishing the public one is the
# normal arrangement.
#
# The middleware is not instrumented and neither variable reaches it. See the
# note in src/instrumentation.ts for why.
#
# Every report is scrubbed before it leaves, in src/lib/sentry-scrub.ts. Phone
# numbers, email addresses, names, cookies and IP addresses never reach Sentry.
# Session replay is refused outright rather than sampled at zero: it would
# record the pledge form as somebody fills it in.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Resend, which sends the pledge confirmation email. Optional everywhere.
#
# Unset, pledges are recorded exactly as they are with it set and no email goes
# out. That is a working configuration rather than a broken one: the email is a
# courtesy on top of a pledge that is already in the database and already on
# the screen, so a missing key must never be able to refuse a pledge.
#
# Unset in production it means nobody gets a confirmation, which is a gap
# rather than a danger, so it is not required the way the Turnstile pair is.
#
# An email only goes to somebody who typed an address into the form. The field
# is optional and most pledgers leave it blank, so most pledges send nothing.
RESEND_API_KEY=

# The From address on that email. Optional. Defaults to the development office:
#   Crystal Fountain <churchdevelopment@newlifesdanairobi.org>
# Whatever this is set to must be on a domain verified in the Resend dashboard,
# or Resend refuses the send.
RESEND_FROM_EMAIL=
